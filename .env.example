# mock, sandbox, or toolkit (see ADR 0006)
PAYPAL_MODE=mock
# Lets mock mode accept webhooks, which it cannot check. Local demo only;
# leave it off on a public host.
MOCK_WEBHOOKS=true
LLM_MODE=mock

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_INVOICER_EMAIL=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

AMOUNT_CAP_CENTS=1000000
# Comma-separated, e.g. USD,EUR. The first is the form default.
ALLOWED_CURRENCIES=USD
TERMS_MIN_DAYS=0
TERMS_MAX_DAYS=120

# Sign-in. Without SECRET_KEY, sessions end when the process restarts.
SECRET_KEY=
COOKIE_SECURE=false
# Lets visitors create their own accounts at /signup.
SIGNUP_ENABLED=false
DEMO_PASSWORD=
# Where users open Duebell. Password reset emails link here; smtp mode needs it.
PUBLIC_URL=

# Reminder email: mock or smtp
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
REMINDER_WINDOW_DAYS=3
PAYPAL_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=30
DATABASE_URL=sqlite:///./duebell.db
